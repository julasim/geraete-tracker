# Geräte-Tracker — Konfiguration
# Kopieren nach .env und ausfüllen. .env gehört NIE ins Repo.

# ── Betrieb ─────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
# Adresse, unter der die App erreichbar ist (für Cookie und Protokolle)
APP_HOSTNAME=localhost

# ── Datenbank ───────────────────────────────────────────────────────────────
# Entwicklung: Container "tracker-db" in WSL auf Port 5433.
# Betrieb: Dienstname aus docker-compose.yml, also postgres:5432.
DATABASE_URL=postgres://tracker:tracker@127.0.0.1:5433/tracker

# Nur für docker-compose — Compose baut DATABASE_URL daraus zusammen
POSTGRES_USER=tracker
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=tracker

# Migrationen beim Start automatisch anwenden
DB_AUTO_MIGRATE=true

# ── Anmeldung ───────────────────────────────────────────────────────────────
# MINDESTENS 32 Zeichen, sonst bricht der Start in Produktion ab.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=nur-fuer-die-entwicklung-bitte-in-produktion-ersetzen

# Cookie nur über HTTPS ausliefern. In der Entwicklung auf false,
# sonst kommt über http://localhost keine Anmeldung zustande.
COOKIE_SECURE=false

# Wie lange bleibt man angemeldet (verlängert sich bei Nutzung)
SESSION_TAGE=30

# ── Passwortschutz ──────────────────────────────────────────────────────────
PASSWORT_MIN_LAENGE=12
# Abgleich gegen bekannte geleakte Passwörter (Have I Been Pwned, k-Anonymity:
# es verlässt nur ein Hash-Präfix den Server, nie das Passwort selbst)
LEAK_PRUEFUNG=true
SPERRE_NACH_VERSUCHEN=10
SPERRE_MINUTEN=15

# ── Etiketten ───────────────────────────────────────────────────────────────
# Steht auf jedem gedruckten Etikett. Leer lassen unterdrückt die Zeile.
FIRMENNAME=SIMA INFRA Construction GmbH
# Bogenformat: 70x37 (24 je Bogen) | 63x38 (21) | 48x25 (40)
ETIKETT_FORMAT=70x37

# ── Dateien ─────────────────────────────────────────────────────────────────
# Fotos und Anhänge. Im Container /data, lokal ein Ordner im Projekt.
DATA_PATH=./daten
UPLOAD_MAX_MB=5

LOG_LEVEL=info
